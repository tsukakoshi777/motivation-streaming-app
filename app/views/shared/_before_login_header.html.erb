<header>
  <nav class='navbar navbar-expand-lg navigation navbar-light bg-light'>
    <%= link_to '/', class: 'navbar-brand' do %>
      <%= image_tag 'oshista-logo2.png', alt: '推しスタ⭐' %>
    <% end %>
    
    <button class='navbar-toggler me-3' 
            data-bs-toggle='collapse' 
            data-bs-target='#navbarSupportedContent'
            aria-controls='navbarSupportedContent' 
            aria-expanded='false' 
            aria-label='Toggle navigation'>
      <span class='navbar-toggler-icon'></span>
    </button>

    <div class='collapse navbar-collapse' id='navbarSupportedContent'>
      <ul class='navbar-nav ms-auto main-nav align-items-center gap-lg-3'>
        <li class='nav-item mt-2 mb-3 me-lg-3'>
          <%= link_to t('defaults.register'), new_user_path, class: 'nav-link' %>
        </li>
        <li class='nav-item mb-2 me-lg-3'>
          <%= link_to t('defaults.login'), login_path, class: 'nav-link' %>
        </li>
      </ul>
    </div>
  </nav>
</header>
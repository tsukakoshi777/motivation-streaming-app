<!-- ========================================
     ヒーローセクション(背景画像付き)
     テンプレート: TEMPLATE PARTY風
     ======================================== -->
<div class="hero-section position-relative">
  <!-- 背景画像(レスポンシブ対応) -->
  <picture>
    <!-- スマホ用(768px以下) -->
    <source 
      media="(max-width: 768px)" 
      srcset="<%= asset_path('oshista-hero-bg-mobile.png') %>"
    >
    <!-- PC用(769px以上) -->
    <img 
      src="<%= asset_path('oshista-hero-bg.png') %>" 
      alt="Oshista Hero Background"
      class="hero-bg-img"
    >
  </picture>

  <!-- オーバーレイ(背景を少し暗くして文字を読みやすくする) -->
  <div class="hero-overlay"></div>

  <!-- コンテンツ -->
  <div class="hero-content position-relative">
    <div class="container">
      <div class="row">
        <div class="col-12 text-center">
          <!-- ロゴ(オプション) -->

          <!-- メインキャッチコピー -->
          <h1 class="hero-title display-3 fw-bold text-white mb-4">
            配信を続けたい！<br class="d-md-none">
            でも自分には難しい？
          </h1>

          <!-- サブキャッチコピー -->
          <p class="hero-subtitle lead text-white mb-5">
            <%= t('.description_html') %>
          </p>

          <!-- CTAボタン -->
          <div class="hero-cta">
            <%= link_to new_survey_profile_path, 
                class: 'btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-lg' do %>
              <i class="fa-solid fa-rocket me-2"></i>+もやもや結晶を調査🔍
            <% end %>
          </div>

          <!-- 補足テキスト(オプション) -->
          <p class="hero-note text-white mt-3 small">
            ※googleログインですぐに利用可能
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================
     新規追加: グラデーション見出しセクション
     テンプレート: title12
     ======================================== -->
<!-- 悩みセクション -->
<section class="problems-section py-5">
  <div class="container">
    <h2 class="title12-parts text-center mt-2 mb-4">
      配信の悩みはきらめく星へ
      <span class="small-parts d-block mt-2">Star Streaming Support</span>
    </h2>

    <p class="text-center lead pt-1 mb-5">
      何を相談すればいいかわからない配信者のための分析ツール。<br>
      あなたの配信の「もやもや」を具体的な成長目標に変換します。
    </p>

    <!-- 悩み3つ(PC: 横並び / スマホ: 縦並び) -->
    <div class="row problems-stars-container">
      <!-- 1つ目: 視聴者が増えない -->
      <div class="col-12 col-md-4 mb-4 problem-star-pair">
        <div class="problem-item text-center">
          <i class="fa-solid fa-chart-line fa-3x text-primary mb-3"></i>
          <h3>視聴者が増えない☁</h3>
          <p class="text-muted">どうすれば視聴者を増やせるのか具体的なアドバイスが欲しい</p>
        </div>

        <!-- 下向き矢印 -->
        <div class="arrow-down text-center mt-3">
          <i class="fa-solid fa-arrow-down fa-2x text-primary"></i>
        </div>

        <!-- 星(スマホのみ表示) -->
        <div class="star-item text-center mt-3 d-md-none">
          <%= image_tag 'oshista-example-star1.png', alt: '星1', class: 'star-image' %>
        </div>
      </div>

      <!-- 2つ目: ファンが少ない -->
      <div class="col-12 col-md-4 mb-4 problem-star-pair">
        <div class="problem-item text-center">
          <i class="fa-solid fa-comments fa-3x text-primary mb-3"></i>
          <h3>応援してくれるファンが少ない☁</h3>
          <p class="text-muted">どうやってファン化を促すのか知りたい</p>
        </div>

        <!-- 下向き矢印 -->
        <div class="arrow-down text-center mt-3">
          <i class="fa-solid fa-arrow-down fa-2x text-primary"></i>
        </div>

        <!-- 星(スマホのみ表示) -->
        <div class="star-item text-center mt-3 d-md-none">
          <%= image_tag 'oshista-example-star2.png', alt: '星2', class: 'star-image' %>
        </div>
      </div>

      <!-- 3つ目: 何を改善すべきか -->
      <div class="col-12 col-md-4 mb-4 problem-star-pair">
        <div class="problem-item text-center">
          <i class="fa-solid fa-lightbulb fa-3x text-primary mb-3"></i>
          <h3>何を改善すべきか分からない☁</h3>
          <p class="text-muted">自身が目指す配信への不足している点を具体的に把握したい</p>
        </div>

        <!-- 下向き矢印 -->
        <div class="arrow-down text-center mt-3">
          <i class="fa-solid fa-arrow-down fa-2x text-primary"></i>
        </div>

        <!-- 星(スマホのみ表示) -->
        <div class="star-item text-center mt-3 d-md-none">
          <%= image_tag 'oshista-example-star3.png', alt: '星3', class: 'star-image' %>
        </div>
      </div>
    </div>

    <!-- 星の画像(PCのみ表示) -->
    <div class="row mt-4 d-none d-md-flex">
      <div class="col-md-4 mb-4">
        <div class="star-item text-center">
          <%= image_tag 'oshista-example-star1.png', alt: '星1', class: 'star-image' %>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="star-item text-center">
          <%= image_tag 'oshista-example-star2.png', alt: '星2', class: 'star-image' %>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="star-item text-center">
          <%= image_tag 'oshista-example-star3.png', alt: '星3', class: 'star-image' %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========================================
     新規追加: CTAセクション
     テンプレート: ui-tools-cta1
     ======================================== -->
<section class="bg-gradient py-3" style="background: #f8f9fa">

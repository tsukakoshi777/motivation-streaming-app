<!-- ========================================
     ヒーローセクション(背景画像付き)
     テンプレート: TEMPLATE PARTY風
     ブレークポイントの調整:
     - スマホ用: 849px以下 (矢印が見切れないように調整)
     - iPad・iPad Pro用: 850px〜1200px (背景画像の端が見切れないように調整)
     - PC用: 1201px以上
     ======================================== -->
<div class="hero-section position-relative">
  <!-- 背景画像(レスポンシブ対応) -->
  <picture>
    <!-- スマホ用(849px以下) -->
    <source 
      media="(max-width: 849px)" 
      srcset="<%= asset_path('oshista-hero-bg-mobile.png') %>"
    >
    <!-- iPad・iPad Pro用(850px〜1100px) -->
    <source 
      media="(min-width: 850px) and (max-width: 1200px)" 
      srcset="<%= asset_path('oshista-hero-bg-tablet.png') %>"
    >
    <!-- PC用 -->
    <img 
      src="<%= asset_path('oshista-hero-bg.png') %>" 
      alt="Oshista Hero Background"
      class="hero-bg-img"
    >
  </picture>

  <!-- オーバーレイ(背景を少し暗くして文字を読みやすくする) -->
  <div class="hero-overlay"></div>

  <!-- コンテンツ -->
  <div class="hero-content position-relative">
    <div class="container">
      <div class="row">
        <div class="col-12 text-center">
          <!-- ロゴ(オプション) -->

          <!-- メインキャッチコピー -->
          <h1 class="hero-title display-3 fw-bold text-white mb-4">
            <%= t('.hero.title_html') %>
          </h1>

          <!-- サブキャッチコピー -->
          <p class="hero-subtitle lead text-white mb-5">
            <%= t('.description_html') %>
          </p>

          <!-- CTAボタン -->
          <div class="hero-cta">
            <%= link_to new_survey_profile_path, 
                class: 'btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-lg' do %>
              <i class="fa-solid fa-rocket me-2"></i><%= t('.hero.cta_button') %>
            <% end %>
          </div>

          <!-- 補足テキスト(オプション) -->
          <p class="hero-note text-white mt-3 small">
            <%= t('.hero.note') %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================
     新規追加: グラデーション見出しセクション
     テンプレート: title12
     ======================================== -->
<!-- 悩みセクション -->
<section class="problems-section py-5">
  <div class="container">
    <h2 class="title12-parts text-center mt-2 mb-4">
      <%= t('.problems.title') %>
      <span class="small-parts d-block mt-2"><%= t('.problems.subtitle') %></span>
    </h2>

    <p class="text-center lead pt-1 mb-5">
      <%= t('.problems.description_html') %>
    </p>

    <!-- 悩み3つ(PC: 横並び / スマホ: 縦並び) -->
    <div class="row problems-stars-container">
      <!-- 1つ目: 視聴者が増えない -->
      <div class="col-12 col-md-4 mb-4 problem-star-pair">
        <div class="problem-item text-center pb-md-0">
          <i class="fa-solid fa-chart-line fa-3x text-primary mb-3"></i>
          <h3><%= t('.problems.problem1.title') %></h3>
          <p class="text-muted"><%= t('.problems.problem1.description') %></p>
        </div>

        <!-- 下向き矢印(スマホのみ表示) -->
        <div class="arrow-down text-center mt-3 d-md-none">
          <i class="fa-solid fa-arrow-down fa-2x text-primary"></i>
        </div>

        <!-- 星(スマホのみ表示) -->
        <div class="star-item text-center mt-3 d-md-none">
          <%= image_tag 'oshista-example-star1.png', alt: '星1', class: 'star-image' %>
        </div>
      </div>

      <!-- 2つ目: ファンが少ない -->
      <div class="col-12 col-md-4 mb-4 problem-star-pair">
        <div class="problem-item text-center pb-md-0">
          <i class="fa-solid fa-comments fa-3x text-primary mb-3"></i>
          <h3><%= t('.problems.problem2.title') %></h3>
          <p class="text-muted"><%= t('.problems.problem2.description') %></p>
        </div>

        <!-- 下向き矢印(スマホのみ表示) -->
        <div class="arrow-down text-center mt-3 d-md-none">
          <i class="fa-solid fa-arrow-down fa-2x text-primary"></i>
        </div>

        <!-- 星(スマホのみ表示) -->
        <div class="star-item text-center mt-3 d-md-none">
          <%= image_tag 'oshista-example-star2.png', alt: '星2', class: 'star-image' %>
        </div>
      </div>

      <!-- 3つ目: 何を改善すべきか -->
      <div class="col-12 col-md-4 mb-4 problem-star-pair">
        <div class="problem-item text-center pb-md-0">
          <i class="fa-solid fa-lightbulb fa-3x text-primary mb-3"></i>
          <h3><%= t('.problems.problem3.title') %></h3>
          <p class="text-muted"><%= t('.problems.problem3.description') %></p>
        </div>

        <!-- 下向き矢印(スマホのみ表示) -->
        <div class="arrow-down text-center mt-3 d-md-none">
          <i class="fa-solid fa-arrow-down fa-2x text-primary"></i>
        </div>

        <!-- 星(スマホのみ表示) -->
        <div class="star-item text-center mt-3 d-md-none">
          <%= image_tag 'oshista-example-star3.png', alt: '星3', class: 'star-image' %>
        </div>
      </div>
    </div>

    <!-- 星の画像(PCのみ表示) -->
    <div class="row mt-4 d-none d-md-flex">
      <div class="col-md-4 mb-4">
        <div class="star-item text-center">
          <!-- 下向き矢印を星の直上に配置 -->
          <div class="arrow-down text-center mb-5">
            <i class="fa-solid fa-arrow-down fa-2x text-primary"></i>
          </div>
          <%= image_tag 'oshista-example-star1.png', alt: '星1', class: 'star-image' %>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="star-item text-center">
          <!-- 下向き矢印を星の直上に配置 -->
          <div class="arrow-down text-center mb-5">
            <i class="fa-solid fa-arrow-down fa-2x text-primary"></i>
          </div>
          <%= image_tag 'oshista-example-star2.png', alt: '星2', class: 'star-image' %>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="star-item text-center">
          <!-- 下向き矢印を星の直上に配置 -->
          <div class="arrow-down text-center mb-5">
            <i class="fa-solid fa-arrow-down fa-2x text-primary"></i>
          </div>

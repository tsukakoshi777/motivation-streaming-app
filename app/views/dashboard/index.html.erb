<div class="container-fluid py-4 px-3 px-md-5" style="background: linear-gradient(to bottom, #fdfdfdff, #ffffffff);">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10 col-xl-8">

      <!-- ヘッダー部分 -->
      <div class="text-center mb-4">
        <h1 class="display-5 fw-bold mb-2" style="background: linear-gradient(to right, #0019cf, #e6ff9e); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
          銀河系REPORT
        </h1>
        <p class="text-muted">あなたの成長の軌跡を振り返りましょう ✨</p>
      </div>

      <!-- 統計情報カード -->
      <div class="card shadow-lg mb-4" style="background: linear-gradient(to right, #0019cf, #e6ff9e);">
        <div class="card-body p-4 p-md-5">
          <h3 class="h4 fw-bold text-white mb-4 text-center">
            ✦あなたの配信銀河系✦
          </h3>

          <!-- 統計情報 -->
          <div class="row g-4 mb-4">
            <div class="col-md-4">
              <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.2);">
                <p class="mb-1 text-white small">見つかった成長の星</p>
                <p class="h3 fw-bold text-white mb-0"><%= @total_goals_count %>個 ⭐</p>
              </div>
            </div>

            <div class="col-md-4">
              <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.2);">
                <p class="mb-1 text-white small">達成した成長の星</p>
                <p class="h3 fw-bold text-white mb-0"><%= @completed_stars_count %>個 🌟</p>
              </div>
            </div>

            <div class="col-md-4">
              <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.2);">
                <p class="mb-1 text-white small">宿した輝きの数</p>
                <p class="h3 fw-bold text-white mb-0"><%= @total_sparks_count %>件 ✨</p>
              </div>
            </div>
          </div>

          <!-- きらめきバッジ -->
          <div class="mb-3">
            <h4 class="fw-bold text-white mb-3 text-center">【きらめきバッジ】</h4>
            <% if @badges.any? %>
              <div class="d-flex flex-wrap justify-content-center gap-3">
                <% @badges.each do |badge| %>
                  <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.2);">
                    <p class="h2 mb-0 text-center"><%= badge[:emoji] %></p>
                    <p class="text-white small mb-0 text-center"><%= badge[:name] %></p>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-white text-center mb-0">まだバッジがありません。輝きメモを記録して、バッジを獲得しましょう！</p>
            <% end %>
          </div>

          <p class="text-white mb-0 text-center">あなたの銀河系は輝きに満ちています ✨</p>
        </div>
      </div>

      <!-- グラフセクション -->
      <div class="row g-4 mb-4">
        <!-- 円グラフ: 目標別の輝きメモ割合 -->
        <div class="col-md-6">
          <div class="card shadow-lg" style="background: linear-gradient(to right, #928b97, #6ba3e9);">
            <div class="card-body p-4">
              <h3 class="h5 fw-bold mb-4 text-white text-center">
                各成長の星の輝き割合
              </h3>
              <% if @goal_sparks_data.present? %>
                <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.9);">
                  <canvas 
              data-controller="chart"
              data-chart-type-value="pie"
              data-chart-data-value='<%= raw goal_sparks_chart_data(@goal_sparks_data) %>'
              data-chart-options-value='<%= raw goal_sparks_chart_options %>'
            ></canvas>
                </div>
              <% else %>
                <p class="text-white text-center">データがありません</p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- 棒グラフ: 月別の輝きメモ件数 -->
        <div class="col-md-6">
          <div class="card shadow-lg" style="background: linear-gradient(to right, #928b97, #6ba3e9);">
            <div class="card-body p-4">
              <h3 class="h5 fw-bold mb-4 text-white text-center">
                月別の宿した輝き数
              </h3>
              <% if @monthly_sparks_data.present? %>
                <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.9);">
                  <canvas 
              data-controller="chart"
              data-chart-type-value="bar"
              data-chart-data-value='<%= raw monthly_sparks_chart_data(@monthly_sparks_data) %>'
              data-chart-options-value='<%= raw monthly_sparks_chart_options %>'
            ></canvas>
                </div>
              <% else %>
                <p class="text-white text-center">データがありません</p>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- ⭐ 成長の星 一覧へ戻るボタン -->
      <div class="text-center mb-4">
        <%= link_to goals_path, class: "btn btn-lg btn-outline-secondary shadow fw-bold" do %>
          <i class="bi bi-arrow-left"></i> ⭐ 成長の星 一覧に戻る
        <% end %>
      </div>

    </div>
  </div>
</div>

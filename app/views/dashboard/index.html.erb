<div class="container-fluid py-4 px-3 px-md-5" style="background: linear-gradient(to bottom, #fdfdfdff, #ffffffff);">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10 col-xl-8">

      <!-- ヘッダー部分 -->
      <div class="text-center mb-4">
        <h1 class="display-5 fw-bold mb-2" style="background: linear-gradient(to right, #0019cf, #e6ff9e); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
          <%= t('.header.title') %>
        </h1>
        <p class="text-muted"><%= t('.header.subtitle') %></p>
      </div>

      <!-- 統計情報カード -->
      <div class="card shadow-lg mb-4" style="background: linear-gradient(to right, #0019cf, #e6ff9e);">
        <div class="card-body p-4 p-md-5">
          <h3 class="h4 fw-bold text-white mb-4 text-center">
            <%= t('.statistics.title') %>
          </h3>

          <!-- 統計情報 -->
          <div class="row g-4 mb-4">
            <div class="col-md-4">
              <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.2);">
                <p class="mb-1 text-white small"><%= t('.statistics.total_goals') %></p>
                <p class="h3 fw-bold text-white mb-0"><%= @total_goals_count %>個 ⭐</p>
              </div>
            </div>

            <div class="col-md-4">
              <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.2);">
                <p class="mb-1 text-white small"><%= t('.statistics.completed_stars') %></p>
                <p class="h3 fw-bold text-white mb-0"><%= @completed_stars_count %>個 🌟</p>
              </div>
            </div>

            <div class="col-md-4">
              <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.2);">
                <p class="mb-1 text-white small"><%= t('.statistics.total_sparks') %></p>
                <p class="h3 fw-bold text-white mb-0"><%= @total_sparks_count %>件 ✨</p>
              </div>
            </div>
          </div>

          <!-- きらめきバッジ -->
          <div class="mb-3">
            <h4 class="fw-bold text-white mb-3 text-center"><%= t('.badges.title') %></h4>
            <% if @badges.any? %>
              <div class="d-flex flex-wrap justify-content-center gap-3">
                <% @badges.each do |badge| %>
                  <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.2); width: 100px; height: 100px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                    <p class="h2 mb-1 text-center"><%= badge[:emoji] %></p>
                    <p class="text-white small mb-0 text-center" style="font-size: 0.75rem; line-height: 1.2;"><%= badge[:name] %></p>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-white text-center mb-0"><%= t('.badges.no_badges') %></p>
            <% end %>
          </div>

          <p class="text-white mb-0 text-center"><%= t('.statistics.galaxy_message') %></p>
        </div>
      </div>

      <!-- グラフセクション -->
      <div class="row g-4 mb-4">
        <!-- 円グラフ: 目標別の輝きメモ割合 -->
        <div class="col-md-6">
          <div class="card shadow-lg h-100" style="background: linear-gradient(to right, #928b97, #6ba3e9);">
            <div class="card-body p-4">
              <h3 class="h5 fw-bold mb-4 text-white text-center">
                <%= t('.charts.goal_sparks_title') %>
              </h3>
              <% if @goal_sparks_data.present? %>
                <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.9);">
                  <canvas 
              data-controller="chart"
              data-chart-type-value="pie"
              data-chart-data-value='<%= raw goal_sparks_chart_data(@goal_sparks_data) %>'
              data-chart-options-value='<%= raw goal_sparks_chart_options %>'
            ></canvas>
                </div>
              <% else %>
                <p class="text-white text-center"><%= t('.charts.no_data') %></p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- 棒グラフ: 月別の輝きメモ件数 -->
        <div class="col-md-6">
          <div class="card shadow-lg h-100" style="background: linear-gradient(to right, #928b97, #6ba3e9);">
            <div class="card-body p-4">
              <h3 class="h5 fw-bold mb-4 text-white text-center">
                <%= t('.charts.monthly_sparks_title') %>
              </h3>
              <% if @monthly_sparks_data.present? %>
                <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.9); min-height: 330px;">
                  <canvas 
              data-controller="chart"
              data-chart-type-value="bar"
              data-chart-data-value='<%= raw monthly_sparks_chart_data(@monthly_sparks_data) %>'
              data-chart-options-value='<%= raw monthly_sparks_chart_options %>'
            ></canvas>
                </div>
              <% else %>
                <p class="text-white text-center"><%= t('.charts.no_data') %></p>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!--  成長の星 一覧へ戻るボタン -->
      <div class="text-center mb-4">
        <%= link_to goals_path, class: "btn btn-lg btn-outline-secondary shadow fw-bold" do %>
          <i class="bi bi-arrow-left"></i> <%= t('.actions.back_to_goals') %>
        <% end %>
      </div>

    </div>
  </div>
</div>

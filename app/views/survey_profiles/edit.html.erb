<div class="container mx-auto px-4 py-8" data-controller="loading" data-job-id="">
  
  <%= render 'shared/turbo_stream_connection' %>

  <!-- ローディングオーバーレイを追加 -->
  <%= render 'shared/loading' %>

  <h1 class="text-3xl font-bold mb-6 text-center"><%= t('.title') %></h1>
  <p class="mb-8 text-center text-gray-600"><%= t('.description_html').html_safe %></p>

  <%= form_with model: @survey_profile, url: goal_survey_profile_path(@goal), method: :patch, local: true do |f| %>
    <!-- data属性を追加（ユーザーには見えない） -->
    <div id="ai-messages"
        data-loading="<%= t('ai.loading') %>"
        data-limit-reached="<%= t('survey_profiles.errors.ai_suggestion_limit_reached') %>"
        data-fetch-failed="<%= t('ai.fetch_failed') %>"
        style="display: none;">
    </div>

    <!-- エラーメッセージ表示 -->
    <%= render 'shared/error_messages', object: f.object %>

    <!-- ========================================
         基本情報セクション
    ======================================== -->
    <div class="bg-white shadow-lg rounded-lg p-3 p-lg-4 pb-1 mb-4">
      <h2 class="text-2xl font-bold mb-4 text-blue-600"><%= t('survey_profiles.shared.sections.basic_info.title') %></h2>

      <!-- 配信プラットフォーム -->
      <div class="mb-4">
        <%= f.label :streaming_platform_id, class: 'block mb-2 font-bold text-gray-700' do %>
          配信プラットフォーム <span class="text-danger">*</span>
        <% end %>
        <%= f.collection_select :streaming_platform_id, 
                                @streaming_platforms, 
                                :id, 
                                :name, 
                                { prompt: '選択してください' }, 
                                class: 'w-full border border-gray-300 rounded px-3 py-2' %>
      </div>

      <!-- 配信カテゴリ -->
      <div class="mb-4">
        <%= f.label :streaming_category_id, class: 'block mb-2 font-bold text-gray-700' do %>
          配信ジャンル <span class="text-danger">*</span>
        <% end %>

        <%= f.collection_select :streaming_category_id, 
                                @streaming_categories, 
                                :id, 
                                :name, 
                                { prompt: '選択してください' }, 
                                class: 'w-full border border-gray-300 rounded px-3 py-2' %>
      </div>

      <!-- 配信経験 -->
      <div class="mb-4">
        <%= f.label :streaming_experience_id, class: 'block mb-2 font-bold text-gray-700' do %>
          配信経験 <span class="text-danger">*</span>
        <% end %>
        <%= f.collection_select :streaming_experience_id, 
                                @streaming_experiences, 
                                :id, 
                                :name, 
                                { prompt: '選択してください' }, 
                                class: 'w-full border border-gray-300 rounded px-3 py-2' %>
      </div>
    </div>

    <!-- ========================================
         現在の活動状況セクション
    ======================================== -->
    <div class="bg-white shadow-lg rounded-lg p-3 p-lg-4 pb-1 mb-4">
      <h2 class="text-2xl font-bold mb-4 text-green-600"><%= t('survey_profiles.shared.sections.activity_status.title') %></h2>

      <!-- 週の配信頻度 -->
      <div class="mb-4">
        <%= f.label :weekly_frequency, class: 'block mb-2 font-bold text-gray-700' do %>
          週の配信頻度（回数） <span class="text-danger">*</span>
        <% end %>

        <%= f.number_field :weekly_frequency, 
                           class: 'w-full border border-gray-300 rounded px-3 py-2', 
                           placeholder: '例: 3',
                           min: 0 %>
        <p class="text-sm text-gray-500 mt-1">週に何回配信していますか？</p>
      </div>

      <!-- 平均視聴者数 -->
      <div class="mb-4">
        <%= f.label :average_listeners, class: 'block mb-2 font-bold text-gray-700' do %>
          平均同時接続視聴者数 <span class="text-danger">*</span>
        <% end %>
        <%= f.number_field :average_listeners, 
                           class: 'w-full border border-gray-300 rounded px-3 py-2', 
                           placeholder: '例: 10',
                           min: 0 %>
        <p class="text-sm text-gray-500 mt-1">配信中の平均的な同時視聴者数を教えてください</p>
      </div>

      <!-- 累計視聴者数 -->
      <div class="mb-4">
        <%= f.label :total_listeners, class: 'block mb-2 font-bold text-gray-700' do %>
          累計視聴者数（おおよその人数） <span class="text-danger">*</span>
        <% end %>
        <%= f.number_field :total_listeners, 
                           class: 'w-full border border-gray-300 rounded px-3 py-2', 
                           placeholder: '例: 100',
                           min: 0 %>
        <p class="text-sm text-gray-500 mt-1">これまでの累計視聴者数（おおよそ）を教えてください</p>
      </div>

      <!-- 視聴者の離脱率 -->
      <div class="mb-4">
        <%= f.label :listener_dropout_rate, class: 'block mb-2 font-bold text-gray-700' do %>
          最近のリスナーの離脱率 <span class="text-danger">*</span>
        <% end %>
        <%= f.select :listener_dropout_rate,
                     [
                       ['0人', 0],
                       ['1〜2人', 1],
                       ['3〜4人', 2],
                       ['5人以上', 3]
                     ],
                     { prompt: '選択してください' },
                     class: 'w-full border border-gray-300 rounded px-3 py-2' %>
        <p class="text-sm text-gray-500 mt-1">配信中に退出するリスナーの数を教えてください</p>
      </div>
    </div>

    <!-- ========================================
         モチベーション（あなたの気持ち）セクション
    ======================================== -->
    <div class="bg-white shadow-lg rounded-lg p-3 p-lg-4 pb-1 mb-4">
      <h2 class="text-2xl font-bold mb-4 text-purple-600"><%= t('survey_profiles.shared.sections.motivation.title') %></h2>

      <!-- モチベーションレベル -->
      <div class="mb-4">
        <%= f.label :motivation_level, class: 'block mb-2 font-bold text-gray-700' do %>
          モチベーションレベル <span class="text-danger">*</span>
        <% end %>
        <div class="flex gap-4">
          <% (1..5).each do |level| %>
            <label class="flex items-center">
              <%= f.radio_button :motivation_level, level, class: 'mr-2' %>
              <span class="text-2xl"><%= '💗' * level %></span>
            </label>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 mt-1">今のモチベーションを教えてください（1: とても低い 〜 5: とても高い）</p>
      </div>

      <!-- 配信で嬉しかった瞬間 -->
      <div class="mb-4 form-field">
        <%= label_tag 'survey_profile[happy_moment]', '配信をしていて嬉しかったこと', class: 'block mb-2 font-bold text-gray-700' %>
        <%= text_area_tag 'survey_profile[happy_moment]',
                          @survey_profile.survey_response&.happy_moment,
                          class: 'w-full border border-gray-300 rounded px-3 py-2',
                          rows: 4,
                          placeholder: '例: リスナーさんからコメントをもらえたとき' %>
      </div>

      <!-- 配信で辛かった瞬間 -->
      <div class="mb-4 form-field">
        <%= label_tag 'survey_profile[sad_moment]', '配信をしていて悲しかったこと（もやもやの原因）', class: 'block mb-2 font-bold text-gray-700' %>
        <%= text_area_tag 'survey_profile[sad_moment]',
                          @survey_profile.survey_response&.sad_moment,
                          class: 'w-full border border-gray-300 rounded px-3 py-2',
                          rows: 4,
                          placeholder: '例: リスナーが全然増えない、コメントがもらえない' %>
        <p class="text-sm text-gray-500 mt-1">ここにもやもやの原因が隠れているかも...正直に書いてみてね</p>
      </div>

      <!-- 配信を続ける理由や目的（複数選択） -->
      <div class="mb-4">
        <%= label_tag 'survey_profile[streaming_reasons]', '配信を続ける理由や目的（3つまで）', class: 'block mb-2 font-bold text-gray-700' %>
        <div class="space-y-2">
          <% streaming_reasons = [
            '稼ぎたい',
            '有名になりたい',
            '承認欲求を満たしたい（褒められたい、ちやほやされたい）',
            '様々な夢を叶えたい',
            'コミュニケーション力を鍛えたい',
            '友達を作りたい',
            '自己肯定感を高めたい（自信をつけたい）',
            '憧れの配信者やアイドルに近づきたい',
            '心の避難所として（寂しい、心の穴を埋めたい）'
          ] %>

          <% 
            # バリデーションエラー時に選択されていた値を保持
            selected_reasons = @survey_profile.survey_response&.streaming_reasons&.split(',') || []
          %>

          <% streaming_reasons.each do |reason| %>
            <label class="flex items-center">
              <%= check_box_tag 'survey_profile[streaming_reasons][]',
                                reason,
                                selected_reasons.include?(reason),
                                class: 'mr-2' %>
              <%= reason %>
            </label>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 mt-1">最大3つまで選択できます</p>
      </div>

      <!-- 配信を続ける理由（その他） -->
      <div class="mb-4 form-field">
        <%= label_tag 'survey_profile[streaming_reasons_other]', '配信を続ける理由や目的（その他）', class: 'block mb-2 font-bold text-gray-700' %>
        <%= text_area_tag 'survey_profile[streaming_reasons_other]',
                          @survey_profile.survey_response&.streaming_reasons_other,
                          class: 'w-full border border-gray-300 rounded px-3 py-2',
                          rows: 3,
                          placeholder: '上記以外の理由があれば教えてください' %>
      </div>

      <!-- 理想の配信スタイル -->
      <div class="mb-4 form-field">
        <%= label_tag 'survey_profile[desired_streaming_style]', '理想の配信スタイル（どんな枠にしたい?）', class: 'block mb-2 font-bold text-gray-700' %>
        <%= text_area_tag 'survey_profile[desired_streaming_style]',
                          @survey_profile.survey_response&.desired_streaming_style,
                          class: 'w-full border border-gray-300 rounded px-3 py-2',
                          rows: 4,
                          placeholder: '例: みんなでワイワイ楽しめる配信、まったり癒し系の配信' %>
      </div>

      <!-- 理想の視聴者層 -->
      <div class="mb-4 form-field">
        <%= label_tag 'survey_profile[desired_listener]', '理想の視聴者層（どんなリスナーに来てほしい?）', class: 'block mb-2 font-bold text-gray-700' %>
        <%= text_area_tag 'survey_profile[desired_listener]',
                          @survey_profile.survey_response&.desired_listener,
                          class: 'w-full border border-gray-300 rounded px-3 py-2',
                          rows: 4,
                          placeholder: '例: 優しくて楽しい人、一緒に盛り上がってくれる人' %>
      </div>

      <!-- 理想の月収 -->
      <div class="mb-4">
        <%= label_tag 'survey_profile[desired_monthly_income]', '理想の月収（配信を続けるためにあると嬉しい月収）', class: 'block mb-2 font-bold text-gray-700' %>
        <%= number_field_tag 'survey_profile[desired_monthly_income]',
                             @survey_profile.survey_response&.desired_monthly_income,
                             class: 'w-full border border-gray-300 rounded px-3 py-2',
                             placeholder: '例: 50000',
                             min: 0 %>
        <p class="text-sm text-gray-500 mt-1">円単位で入力してください</p>
      </div>
    </div>

    <!-- ========================================
         目指す方向性（未来を描く）セクション
    ======================================== -->
    <div class="bg-white shadow-lg rounded-lg p-3 p-lg-4 pb-1 mb-4">
      <h2 class="text-2xl font-bold mb-4 text-pink-600"><%= t('survey_profiles.shared.sections.future_direction.title') %></h2>

      <!-- 目標の出典選択 -->
      <div class="mb-4">
        <%= label_tag 'survey_result[goal_source]', '成長の星(目標)の出典選択', class: 'block mb-2 font-bold text-gray-700' %>
        <div class="space-y-2">
          <% 
            # バリデーションエラー時は params から、通常時は @survey_profile.survey_result から取得
            if params.dig(:survey_result, :goal_source).present?
              # バリデーションエラー時: params から取得 (文字列の '0' や '1')
              selected_goal_source = params[:survey_result][:goal_source].to_i
            elsif @survey_profile.survey_result&.goal_source.present?
              # 通常時: enum の値を整数に変換
              selected_goal_source = @survey_profile.survey_result.goal_source == 'ai_suggestion' ? 0 : 1
            else
              # デフォルト値
              selected_goal_source = 0
            end
          %>
          <label class="flex items-center">
            <%= radio_button_tag 'survey_result[goal_source]', 
                                 0, 
                                 selected_goal_source == 0, 
                                 class: 'mr-2', 
                                 id: 'goal_source_ai' %>
            AI提案から選択する
          </label>
          <label class="flex items-center">
            <%= radio_button_tag 'survey_result[goal_source]', 
                                 1, 
                                 selected_goal_source == 1, 
                                 class: 'mr-2' %>
            自分で設定する
          </label>
        </div>
        <p class="text-sm text-gray-500 mt-1">あなたのもやもやから、自分だけの成長の星を作りましょう! ✨</p>

        <!-- 🆕 使用回数とリセット日時の表示 -->
        <div class="text-center lg:text-left mt-3 p-3 bg-light rounded" style="width: 100%; max-width: 390px;">
          <small class="text-gray-600">
            <% remaining = current_user.remaining_ai_suggestion_count %>
            <% if remaining > 0 %>
              💡 AI提案は <strong class="text-blue-600 font-semibold">あと<span id="ai-suggestion-remaining"><%= remaining %></span>回</strong> 使用できます
              <br>
              <small>(<%= current_user.ai_suggestion_reset_date.tomorrow.strftime('%m月%d日') %> にリセットされます)</small>
            <% else %>
              💡 <strong class="text-red-600 font-semibold">本日のAI提案は利用できません</strong>
              <br>
              <small>(<%= current_user.ai_suggestion_reset_date.tomorrow.strftime('%m月%d日') %> にリセットされます)</small>
            <% end %>
          </small>
        </div>

        <!--  AI提案取得ボタン（常に表示） -->
        <div class="mt-4">
          <button type="button" 
                  class="btn btn-primary" 
                  id="fetch-ai-button">
            <%= t('survey_profiles.shared.buttons.fetch_ai_suggestion') %>
          </button>
          <p class="text-sm text-gray-500 mt-2">
            <%= t('survey_profiles.shared.buttons.fetch_ai_suggestion_note_html').html_safe %>
          </p>
        </div>

        
        <!-- ★ データを受け取る要素に変更 -->
        <%= turbo_frame_tag "ai_suggestion_form" do %>
          <div id="ai-suggestion-data"></div>
        <% end %>

      </div>

      <!-- 目標のタイトル -->
      <div class="mb-4">
        <%= label_tag 'survey_result[goal_title]', '成長の星（目標）のタイトル', class: 'block mb-2 font-bold text-gray-700' %>
        <%= text_field_tag 'survey_result[goal_title]',
                           @survey_profile.survey_result&.goal_title,
                           class: 'w-full border border-gray-300 rounded px-3 py-2',
                           style: 'width: 100%; max-width: 450px;',
                           placeholder: '例: 3ヶ月で平均視聴者数20人を目指す!', 
                           id: 'survey_result_goal_title' %>
        <p class="text-sm text-gray-500 mt-1">自分で設定する場合は入力してください</p>
      </div>

      <!-- 目標の詳細説明 -->
      <div class="mb-4 form-field">
        <%= label_tag 'survey_result[goal_description]', '成長の星（目標）の詳細説明', class: 'block mb-2 font-bold text-gray-700' %>
        <%= text_area_tag 'survey_result[goal_description]',
                          @survey_profile.survey_result&.goal_description,
                          class: 'w-full border border-gray-300 rounded px-3 py-2',
                          rows: 5,
                          placeholder: '例: 毎日配信を続けて、リスナーとのコミュニケーションを大切にする。視聴者参加型の企画を月1回実施する。', 
                          id: 'survey_result_goal_description' %>
        <p class="text-sm text-gray-500 mt-1">自分で設定する場合は入力してください</p>
      </div>

      <!--  具体的なアクションプラン -->
      <div class="mb-4 form-field">
        <%= label_tag 'survey_result[action_plan]', '🚀 具体的なアクションプラン', class: 'block mb-2 font-bold text-gray-700' %>
        <%= text_area_tag 'survey_result[action_plan]',
                      params.dig(:survey_result, :action_plan) || @survey_profile.survey_result&.action_plan,
                      class: 'w-full border border-gray-300 rounded px-3 py-2 action-plan-textarea',
                      rows: 10,
                      placeholder: '例:
      # 具体的なアクションプラン

      ## 短期目標(1ヶ月)  
      ◇ 毎日配信を続ける
      ◇ リスナーとのコミュニケーションを大切にする

      ## 中期目標(3ヶ月)
      ◇ 視聴者参加型の企画を月1回実施する
      ◇ SNSでの告知を強化する

      ## 長期目標(6ヶ月)
      ◇ 平均視聴者数20人を達成する
      ◇ コラボ配信を実施する',
                        id: 'survey_result_action_plan' %>
        <p class="text-sm text-gray-500 mt-1">改行すると自動的に◇が挿入されます(変更も可能)</p>
      </div>
    </div>

    <!-- 送信ボタン -->
    <div class="text-center">
      <%= f.submit t('.submit_button'), 
               class: 'text-white font-bold py-3 px-8 transition duration-300 text-lg cursor-pointer',
               style: 'background: linear-gradient(to right, #d9ec48, #5590f7); border-radius: 0.5rem; border: none;' %>
    </div>
  <% end %>
</div>
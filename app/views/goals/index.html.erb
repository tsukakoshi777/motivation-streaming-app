<div class="container mx-auto py-8 container-index-padding" style="max-width: 1000px;">
  <!-- ヘッダーエリア -->
  <div class="mb-8">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-800 mt-4">
        <%= t('.title') %>
      </h1>
    </div>

    <!-- 説明文とボタンエリアを横並びに -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-4 mb-4">
      <!-- 説明文 -->
      <p class="text-gray-600 mb-0">
        <%= t('.description_html') %>
      </p>

      <!-- アクションボタンエリア -->
      <div class="d-flex flex-column flex-sm-row gap-3">
        <%= link_to new_survey_profile_path,
            class: "btn btn-lg text-white fw-bold shadow-lg",
            style: "background: linear-gradient(to right, #c0c0c0, #ae3bbf);" do %>
          <span style="font-size: 1.25rem;"><%= t('.new_survey_button') %></span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 🆕 検索フォームエリア（Stimulus対応） -->
  <div class="mb-6" 
     data-controller="goal-search"
     data-goal-search-url-value="<%= autocomplete_goals_path %>"
     data-action="click@window->goal-search#clickOutside">

    <%= form_with url: goals_path, method: :get, local: true, 
      data: { goal_search_target: "form" },
      class: "d-flex gap-2" do |f| %>

      <div class="flex-grow-1 position-relative">
        <%= f.search_field :q, 
          value: params[:q],
          placeholder: t('.search.placeholder'),
          class: "form-control form-control-lg border-2 focus:ring-2 focus:ring-pink-500",
          autocomplete: "off",
          data: { 
            goal_search_target: "input",
            action: "input->goal-search#search keydown->goal-search#navigate"
          } %>

        <!-- 検索候補のドロップダウン -->
        <div data-goal-search-target="suggestions"
           class="position-absolute w-100 bg-white border rounded shadow-lg mt-1 d-none"
           style="z-index: 1000; max-height: 400px; overflow-y: auto;">
        </div>
      </div>

      <%= f.submit t('.search.submit'), 
        class: "btn btn-lg btn-primary fw-bold",
        style: "min-width: 100px;" %>

      <% if params[:q].present? %>
        <%= link_to t('.search.clear'), goals_path, 
          class: "btn btn-lg btn-secondary",
          style: "min-width: 100px;" %>
      <% end %>
    <% end %>

    <!-- 🆕 検索結果の表示 -->
    <% if params[:q].present? %>
      <div class="mt-3 p-3 bg-light rounded">
        <span class="text-muted">
          「<span class="fw-bold text-dark"><%= params[:q] %></span>」の検索結果：
          <span class="badge bg-primary"><%= @goals.total_count %>件</span>
        </span>
      </div>
    <% end %>
  </div>

  <!-- 成長の星一覧 -->
  <% if @goals.present? %>
    <!-- ページネーション情報 -->
    <div class="mb-4 text-sm text-gray-600">

    </div>

    <!-- カードグリッド（Bootstrap のグリッドシステムを使用） -->
    <div class="row">
      <div class="col-12">
        <div class="row">
          <% @goals.each do |goal| %>
            <%= render 'goal_card', goal: goal %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- ページネーション -->
    <div class="flex justify-center mt-8 mb-4">
      <%= paginate @goals, theme: 'bootstrap-5' %>
    </div>

  <% else %>
    <!-- 成長の星が0件の場合 -->
    <div class="text-center py-16 bg-gradient-to-br from-pink-50 to-purple-50 rounded-xl shadow-lg p-4">
      <div class="text-6xl mb-4 animate-bounce">🌟</div>
      <h2 class="text-2xl font-bold text-gray-800 mb-4">
        <%= t('.no_goals.title') %>
      </h2>
      <p class="text-gray-600 mb-2">
        <%= t('.no_goals.subtitle') %>
      </p>
      <p class="text-gray-600 mb-8">
        <%= t('.no_goals.description') %>
      </p>

      <div class="mt-6 text-sm text-gray-500">
        <p>📝 もやもや結晶シートでは...</p>
        <div class="mt-2 space-y-1">
          <p>✓ あなたの配信の悩みを整理</p>
          <p>✓ 理想の配信スタイルを明確化</p>
          <p>✓ 具体的な目標を設定</p>
        </div>
      </div>
    </div>
  <% end %>
</div>
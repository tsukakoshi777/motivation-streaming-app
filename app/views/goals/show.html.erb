<div class="container-fluid py-4 px-3 px-md-5" style="background: linear-gradient(to bottom, #fdfdfdff, #ffffffff);">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10 col-xl-8">

      <!-- ヘッダー部分 -->
      <div class="text-center mb-4">
        <h1 class="display-5 fw-bold mb-2" style="background: linear-gradient(to right, #fffb00ff, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
          <%= t('.title') %>
        </h1>
        <p class="text-muted"><%= t('.description') %></p>
      </div>

      <!-- 目標カード -->
      <div class="card shadow-lg mb-4" style="background: linear-gradient(to bottom right, #ffffffff, #ffffffff);">
        <div class="card-body p-4 p-md-5">

          <!-- タイトル・作成日・ボタンエリア -->
          <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
            <!-- タイトルと作成日 -->
            <div class="flex-grow-1">
              <h2 class="h3 fw-bold text-purple mb-2">🌟 <%= @goal.survey_result.goal_title %></h2>
              <small class="text-muted">
                作成日: <%= @goal.created_at.strftime('%Y年%m月%d日') %>
              </small>
            </div>

            <!-- 編集・削除ボタン -->
            <div class="d-flex gap-2">
              <%= link_to edit_goal_path(@goal), class: "btn btn-lg btn-outline-primary shadow fw-bold" do %>
                <i class="bi bi-pencil"></i> <%= t('.actions.edit') %>
              <% end %>

              <%= button_to goal_path(@goal), 
                  method: :delete,
                  form: { 
                    style: "display: inline;",
                    onsubmit: "return confirm('#{t('.actions.delete_confirm')}');" 
                  },
                  class: "btn btn-lg btn-outline-danger shadow fw-bold" do %>
                <i class="bi bi-trash"></i> <%= t('.actions.delete') %>
              <% end %>
            </div>
          </div>

          <!-- 目標の詳細 -->
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <h3 class="h5 fw-bold text-secondary mb-3">📝 目標の詳細</h3>
              <p class="text-dark" style="white-space: pre-wrap;"><%= @goal.survey_result.goal_description&.strip %></p>
            </div>
          </div>

          <!-- ★★★ アクションプランを追加 ★★★ -->
          <div class="card shadow-sm">
            <div class="card-body">
              <h3 class="h5 fw-bold text-secondary mb-3">📋 アクションプラン</h3>
              <div class="text-dark" style="white-space: pre-wrap;"><%= @goal.survey_result.action_plan&.strip %></div>
            </div>
          </div>

          <!-- フッター（AI提案バッジ） -->
          <div class="mt-4">
            <span class="badge rounded-pill px-3 py-2" style="background-color: #ddd6fe; color: #7c3aed; font-size: 0.875rem;">
              <%= @goal.survey_result.ai_suggestion? ? '🤖 AI提案' : '✍️ 自分で設定' %>
            </span>
          </div>
        </div>
      </div>

      <!-- アクションボタンエリア -->
      <div class="card shadow-lg text-center mb-4" style="background: linear-gradient(to right, #ec4899, #a855f7);">
        <div class="card-body p-4 p-md-5">
          <h3 class="h4 fw-bold text-white mb-3">
            <%= t('.next_step.title') %>
          </h3>
          <p class="text-white mb-4">
            <%= t('.next_step.description') %>
          </p>

          <!-- ★★★ ここから成長の星セクション ★★★ -->
          <!-- PC画面用のレイアウト（横並び） -->
          <div class="d-none d-md-block">
            <div class="row g-4 align-items-center">
              <!-- 左側:GIFアニメーション -->
              <div class="col-md-6">
                <div class="d-flex justify-content-center align-items-center h-100">
                  <%= image_tag star_gif(@goal), alt: "成長の星", class: "img-fluid", style: "max-width: 300px;" %>
                </div>
              </div>

              <!-- 右側:統計情報 + 星の輝きメーター -->
              <div class="col-md-6">
                <!-- 統計情報 -->
                <div class="mb-4">
                  <div class="p-3 rounded mb-3" style="background-color: rgba(255, 255, 255, 0.2);">
                    <p class="mb-1 text-white small"><%= t('.statistics.sparks_count') %></p>
                    <p class="h4 fw-bold text-white mb-0"><%= @goal.sparks.count %>件</p>
                  </div>

                  <div class="p-3 rounded mb-3" style="background-color: rgba(255, 255, 255, 0.2);">
                    <p class="mb-1 text-white small"><%= t('.statistics.start_date') %></p>
                    <p class="h5 fw-bold text-white mb-0"><%= @goal.created_at.strftime('%Y/%m/%d') %></p>
                  </div>

                  <div class="p-3 rounded mb-3" style="background-color: rgba(255, 255, 255, 0.2);">
                    <p class="mb-1 text-white small"><%= t('.statistics.latest_record') %></p>
                    <p class="h5 fw-bold text-white mb-0">
                      <%= @goal.sparks.any? ? @goal.sparks.order(created_at: :desc).first.created_at.strftime('%Y/%m/%d') : "-" %>
                    </p>
                  </div>
                </div>

                <!-- 星の輝きメーター -->
                <div>
                  <p class="mb-2 fw-bold text-white"><%= t('.achievement_meter.title', rate: achievement_rate(@goal)) %></p>
                  <div class="text-center mb-3" style="font-size: 3rem; color: #fbbf24;">
                    <%= star_emoji(@goal) %>
                  </div>
                  <div class="progress" style="height: 30px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: <%= achievement_rate(@goal) %>%;" aria-valuenow="<%= achievement_rate(@goal) %>" aria-valuemin="0" aria-valuemax="100">
                      <%= achievement_rate(@goal) %>%
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- スマホ画面用のレイアウト（縦並び） -->
          <div class="d-md-none">
            <!-- GIFアニメーション -->
            <div class="text-center mb-4">
              <%= image_tag star_gif(@goal), alt: "成長の星", class: "img-fluid" %>
            </div>

            <!-- 統計情報 -->
            <div class="mb-4">
              <div class="p-3 rounded mb-3" style="background-color: rgba(255, 255, 255, 0.2);">
                <p class="mb-1 text-white small"><%= t('.statistics.sparks_count') %></p>
                <p class="h4 fw-bold text-white mb-0"><%= @goal.sparks.count %>件</p>
              </div>

              <div class="p-3 rounded mb-3" style="background-color: rgba(255, 255, 255, 0.2);">
                <p class="mb-1 text-white small"><%= t('.statistics.start_date') %></p>
                <p class="h5 fw-bold text-white mb-0"><%= @goal.created_at.strftime('%Y/%m/%d') %></p>
              </div>

              <div class="p-3 rounded mb-3" style="background-color: rgba(255, 255, 255, 0.2);">
                <p class="mb-1 text-white small"><%= t('.statistics.latest_record') %></p>
                <p class="h5 fw-bold text-white mb-0">
                  <%= @goal.sparks.any? ? @goal.sparks.order(created_at: :desc).first.created_at.strftime('%Y/%m/%d') : "-" %>
                </p>
              </div>
            </div>

            <!-- 星の輝きメーター -->
            <div>
              <p class="mb-2 fw-bold text-white"><%= t('.achievement_meter.title', rate: achievement_rate(@goal)) %></p>
              <div class="text-center mb-3" style="font-size: 3rem; color: #fbbf24;">
                <%= star_emoji(@goal) %>
              </div>
              <div class="progress" style="height: 30px;">
                <div class="progress-bar bg-warning" role="progressbar" style="width: <%= achievement_rate(@goal) %>%;" aria-valuenow="<%= achievement_rate(@goal) %>" aria-valuemin="0" aria-valuemax="100">
                  <%= achievement_rate(@goal) %>%
                </div>
              </div>
            </div>
          </div>
          <!-- ★★★ 成長の星セクション終了 ★★★ -->
        </div>
      </div>

      <!-- ✨ ここから輝き機能セクション ✨ -->
      <div class="sparks-section mb-4">
        <!-- セクションヘッダー -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h4 fw-bold mb-0" style="color: #9333ea;">
            ✨ 輝きの記録
          </h2>
          <span class="badge rounded-pill px-3 py-2" 
                style="background-color: #f3e8ff; color: #7c3aed; font-size: 1rem;">
            <%= @goal.sparks.count %>件
          </span>
        </div>

        <%# ⭐ 成功メッセージ表示用のコンテナ %>
        <div id="spark-flash-messages" class="mb-3"></div>

        <!-- 投稿フォーム -->
        <div class="spark-form-wrapper mb-4" id="spark_form_wrapper">
          <%= render 'sparks/form', goal: @goal, spark: Spark.new %>
        </div>

        <!-- 輝き一覧 -->
        <div id="sparks_list">
          <%= render @sparks %>
        </div>

        <% if @goal.sparks.empty? %>
          <div id="sparks_empty_message" class="card shadow-sm text-center py-5">
            <div class="card-body">
              <p class="text-muted mb-2" style="font-size: 3rem;">✨</p>
              <p class="text-muted mb-1">まだ輝きが記録されていません</p>
              <p class="small text-muted mb-0">最初の一歩を記録してみましょう！</p>
            </div>
          </div>
        <% end %>
      </div>

      <!-- 基本情報セクション -->
      <div class="card shadow-lg mb-4">
        <div class="card-body p-4 p-md-5">
          <h2 class="h4 fw-bold mb-4" style="color: #2563eb;">📊 基本情報</h2>

          <div class="row g-3">
            <div class="col-12 col-md-6">
              <div class="p-3 rounded" style="background-color: #f9fafb;">
                <p class="small text-muted mb-1">配信プラットフォーム</p>
                <p class="h6 fw-semibold text-dark mb-0">
                  <%= @goal.survey_profile.streaming_platform.name %>
                </p>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <div class="p-3 rounded" style="background-color: #f9fafb;">
                <p class="small text-muted mb-1">配信ジャンル</p>
                <p class="h6 fw-semibold text-dark mb-0">
                  <%= @goal.survey_profile.streaming_category.name %>
                </p>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <div class="p-3 rounded" style="background-color: #f9fafb;">
                <p class="small text-muted mb-1">配信経験</p>
                <p class="h6 fw-semibold text-dark mb-0">
                  <%= @goal.survey_profile.streaming_experience.name %>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- 現在の活動状況セクション -->
      <div class="card shadow-lg mb-4">
        <div class="card-body p-4 p-md-5">
          <h2 class="h4 fw-bold mb-4" style="color: #16a34a;">📈 現在の活動状況</h2>

          <div class="row g-3">
            <div class="col-12 col-md-6">
              <div class="p-3 rounded" style="background-color: #f9fafb;">
                <p class="small text-muted mb-1">週の配信頻度</p>
                <p class="h6 fw-semibold text-dark mb-0">
                  週 <%= @goal.survey_profile.weekly_frequency %> 回
                </p>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <div class="p-3 rounded" style="background-color: #f9fafb;">
                <p class="small text-muted mb-1">平均同時接続視聴者数</p>
                <p class="h6 fw-semibold text-dark mb-0">
                  <%= @goal.survey_profile.average_listeners %> 人
                </p>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <div class="p-3 rounded" style="background-color: #f9fafb;">
                <p class="small text-muted mb-1">総合視聴者数</p>
                <p class="h6 fw-semibold text-dark mb-0">
                  <%= @goal.survey_profile.total_listeners %> 人
                </p>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <div class="p-3 rounded" style="background-color: #f9fafb;">
                <p class="small text-muted mb-1">最近のリスナーの離脱人数</p>
                <p class="h6 fw-semibold text-dark mb-0">
                  <%= ['0人', '1〜2人', '3〜4人', '5人以上'][@goal.survey_profile.listener_dropout_rate] %>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- モチベーション（あなたの気持ち）セクション -->
      <div class="card shadow-lg mb-4">
        <div class="card-body p-4 p-md-5">
          <h2 class="h4 fw-bold mb-4" style="color: #9333ea;">💗 モチベーション（あなたの気持ち）</h2>

          <!-- モチベーションレベル -->
          <div class="p-3 rounded mb-3" style="background-color: #f9fafb;">
            <p class="small text-muted mb-2">現在のモチベーションレベル</p>
            <div style="font-size: 2rem;">
              <%= '💗' * @goal.survey_profile.motivation_level %>
              <%= '🖤' * (5 - @goal.survey_profile.motivation_level) %>
            </div>
            <p class="small text-muted mt-1">
              <%= @goal.survey_profile.motivation_level %> / 5
            </p>
          </div>

          <!-- 配信で嬉しかったこと -->
          <div class="p-3 rounded mb-3" style="background-color: #f9fafb;">
            <p class="small text-muted mb-2">😊 配信で嬉しかったこと</p>
            <p class="text-dark mb-0" style="white-space: pre-wrap;">
              <%= @goal.survey_profile.survey_response.happy_moment %>
            </p>
          </div>

          <!-- 配信で辛かったこと -->
          <div class="p-3 rounded mb-3" style="background-color: #f9fafb;">
            <p class="small text-muted mb-2">😢 配信で辛かったこと</p>
            <p class="text-dark mb-0" style="white-space: pre-wrap;">
              <%= @goal.survey_profile.survey_response.sad_moment %>
            </p>
          </div>

          <!-- 配信を続ける理由 -->
          <div class="p-3 rounded mb-3" style="background-color: #f9fafb;">
            <p class="small text-muted mb-2">🔥 配信を続ける理由</p>

            <% if @streaming_reasons.present? %>
              <div class="d-flex flex-wrap gap-2 mb-2">
                <% @streaming_reasons.each do |reason| %>
                  <span class="badge rounded-pill px-3 py-2" style="background-color: #f3e8ff; color: #7c3aed;">
                    <%= reason %>
                  </span>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted mb-2">配信理由が登録されていません</p>
            <% end %>

            <% if @goal.survey_profile.survey_response.streaming_reasons_other.present? %>
              <p class="text-dark mb-0 mt-2">
                <span class="fw-semibold">その他:</span>
                <%= @goal.survey_profile.survey_response.streaming_reasons_other %>
              </p>
            <% end %>
          </div>

          <!-- 理想の配信スタイル -->
          <div class="p-3 rounded mb-3" style="background-color: #f9fafb;">
            <p class="small text-muted mb-2">✨ 理想の配信スタイル</p>
            <p class="text-dark mb-0" style="white-space: pre-wrap;">
              <%= @goal.survey_profile.survey_response.desired_streaming_style %>
            </p>
          </div>

          <!-- 理想の視聴者層 -->
          <div class="p-3 rounded mb-3" style="background-color: #f9fafb;">
            <p class="small text-muted mb-2">👥 理想の視聴者層</p>
            <p class="text-dark mb-0" style="white-space: pre-wrap;">
              <%= @goal.survey_profile.survey_response.desired_listener %>
            </p>
          </div>

          <!-- 理想の月収 -->
          <div class="p-3 rounded" style="background-color: #f9fafb;">
            <p class="small text-muted mb-2">💰 理想の月収</p>
            <p class="h4 fw-bold text-dark mb-0">
              <%= number_to_currency(@goal.survey_profile.survey_response.desired_monthly_income, 
                         unit: '円', 
                         format: '%n%u',
                         precision: 0) %>
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
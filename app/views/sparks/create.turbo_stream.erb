<% if @spark.errors.any? %>
  <%# エラー時：フォームを再表示 %>
  <%= turbo_stream.replace "spark_form" do %>
    <%= turbo_frame_tag "spark_form" do %>
      <%= render 'sparks/form', goal: @goal, spark: @spark %>
    <% end %>
  <% end %>

<% else %>
  <%# 成功時：1ページ目の内容を丸ごと置き換える %>
  
  <%# 1. 輝き一覧を丸ごと置き換え（1ページ目を表示） %>
  <%= turbo_stream.replace "sparks_list" do %>
    <div id="sparks_list">
      <% if @sparks.any? %>
        <%= render @sparks %>
      <% else %>
        <div id="sparks_empty_message" class="text-center text-muted py-5">
          <%= t('sparks.index.no_sparks') %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# 2. ページネーションを更新（1ページ目を表示） %>
  <%= turbo_stream.replace "sparks_pagination" do %>
    <div id="sparks_pagination" class="d-flex justify-content-center mt-4">
      <% if @sparks.present? %>
        <%= paginate @sparks, theme: 'bootstrap-5', params: { controller: 'goals', action: 'show', id: @goal.id } %>
      <% end %>
    </div>
  <% end %>

  <%# ★★★ ここから件数更新を追加 ★★★ %>

  <%# 3. セクションヘッダーのバッジを更新 %>
  <%= turbo_stream.update "spark_count_badge_#{@goal.id}" do %>
    <span class="badge rounded-pill px-3 py-2" 
    style="background-color: #f3e8ff; color: #7c3aed; font-size: 1rem;">
      <%= @sparks_count %>件
    </span>
  <% end %>

  <%# 4. PC画面用の統計情報を更新 %>
  <%= turbo_stream.update "spark_count_pc_#{@goal.id}" do %>
    <div class="p-3 rounded mb-3" style="background-color: rgba(255, 255, 255, 0.2);">
      <p class="mb-1 text-white small">✨ 輝きの記録</p>
      <p class="h4 fw-bold text-white mb-0"><%= @sparks_count %>件</p>
    </div>
  <% end %>

  <%# 5. スマホ画面用の統計情報を更新 %>
  <%= turbo_stream.update "spark_count_mobile_#{@goal.id}" do %>
    <div class="p-3 rounded mb-3" style="background-color: rgba(255, 255, 255, 0.2);">
      <p class="mb-1 text-white small">✨ 輝きの記録</p>
      <p class="h4 fw-bold text-white mb-0"><%= @sparks_count %>件</p>
    </div>
  <% end %>

  <%# ★★★ 件数更新ここまで ★★★ %>


  <%# 3. フォームをリセット %>
  <%= turbo_stream.replace "spark_form" do %>
    <%= turbo_frame_tag "spark_form" do %>
      <%= render 'sparks/form', goal: @goal, spark: Spark.new %>
    <% end %>
  <% end %>

  <%# 4. 成功メッセージを表示 %>
  <%= turbo_stream.update "spark-flash-messages" do %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= t('sparks.create.success') %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <script>
      (function() {
        const alert = document.querySelector('#spark-flash-messages .alert');
        if (alert) {
          setTimeout(() => {
            alert.classList.remove('show');
            setTimeout(() => alert.remove(), 150);
          }, 3000);
        }
      })();
    </script>
  <% end %>

  <%# 5. URLを1ページ目に更新 %>
  <%= turbo_stream.append 'body' do %>
    <script>
      history.replaceState(null, '', '<%= goal_path(@goal, page: 1) %>');
    </script>
  <% end %>
<% end %>
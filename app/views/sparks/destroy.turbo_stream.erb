<%# 輝き一覧を丸ごと置き換え %>
<%= turbo_stream.replace "sparks_list" do %>
  <% if @sparks.present? %>
    <div id="sparks_list">
      <%= render @sparks %>
    </div>
  <% else %>
    <div id="sparks_list">
      <div id="sparks_empty_message" class="card shadow-sm text-center py-5">
        <div class="card-body">
          <p class="text-muted mb-2" style="font-size: 3rem;">✨</p>
          <p class="text-muted mb-1">まだ輝きが記録されていません</p>
          <p class="small text-muted mb-0">最初の一歩を記録してみましょう!</p>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<%# ページネーションを更新 %>
<%= turbo_stream.replace "sparks_pagination" do %>
  <% if @sparks.present? %>
    <div id="sparks_pagination" class="d-flex justify-content-center mt-4">
      <%= paginate @sparks, theme: 'bootstrap-5', params: { controller: 'goals', action: 'show', id: @goal.id, page: @current_page } %>
    </div>
  <% else %>
    <div id="sparks_pagination"></div>
  <% end %>
<% end %>

<%# URLを更新(ページ番号が変わった場合のみ) %>
<% if @current_page != params[:page].to_i %>
  <%= turbo_stream.append 'head' do %>
    <script>
      history.replaceState(null, '', '<%= goal_path(@goal, page: @current_page) %>');
    </script>
  <% end %>
<% end %>

<%# 成功メッセージを表示 %>
<%= turbo_stream.update "spark-flash-messages" do %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= flash[:success] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <script>
    (function() {
      const alert = document.querySelector('#spark-flash-messages .alert');
      if (alert) {
        setTimeout(() => {
          alert.classList.remove('show');
          setTimeout(() => alert.remove(), 150);
        }, 3000);
      }
    })();
  </script>
<% end %>